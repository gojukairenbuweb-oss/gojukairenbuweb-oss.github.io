---
// Griglia di schede (news, gallerie, categorie)
interface Card { href: string; title: string; image?: string; meta?: string; text?: string }
interface Props { cards: Card[]; columns?: 2 | 3 }
const { cards, columns = 3 } = Astro.props;
---
<ul class:list={['grid grid-cols-1 sm:grid-cols-2 gap-6 list-none p-0', columns === 3 && 'lg:grid-cols-3']}>
  {cards.map((c) => (
    <li class="group rounded-xl overflow-hidden bg-white shadow-sm ring-1 ring-black/5 hover:shadow-md transition">
      <a href={c.href} class="block h-full">
        {c.image
          ? <img src={c.image} alt="" loading="lazy" class="aspect-[4/3] w-full object-cover group-hover:scale-[1.02] transition" />
          : <div class="aspect-[4/3] w-full bg-[repeating-linear-gradient(45deg,#f0efe9,#f0efe9_10px,#e9e7df_10px,#e9e7df_20px)]" aria-hidden="true"></div>}
        <div class="p-4">
          <h3 class="font-heading font-bold text-lg leading-snug group-hover:text-primary">{c.title}</h3>
          {c.meta && <p class="text-sm text-muted mt-1">{c.meta}</p>}
          {c.text && <p class="mt-2 text-default">{c.text}</p>}
        </div>
      </a>
    </li>
  ))}
</ul>
