---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Gallery as Props } from '~/types';

// Image grid with an optional lightbox built on the native <dialog>: no
// library, keyboard friendly (Escape closes, arrows navigate), works without
// JavaScript (the images are simply not clickable).

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  images = [],
  columns = 3,
  lightbox = true,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const columnsClass =
  columns === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : columns === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  <aw-gallery>
    <ul class:list={['grid grid-cols-1 gap-4 md:gap-6 list-none', columnsClass]}>
      {
        images.map(({ src, alt, caption, href }, index) => (
          <li class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            <figure>
              <button
                type="button"
                class="group block w-full overflow-hidden rounded-lg bg-gray-100 dark:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                data-aw-gallery-open={lightbox ? index : undefined}
                data-full={typeof src === 'string' ? src : src?.src}
                disabled={!lightbox}
                aria-label={lightbox ? `Apri foto ${index + 1} di ${images.length}${alt ? `: ${alt}` : ''}` : undefined}
              >
                <Image
                  class="aspect-[4/3] w-full object-cover transition group-hover:scale-[1.03]"
                  widths={[400, 640]}
                  sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 400px"
                  width={400}
                  height={300}
                  layout="cover"
                  format="webp"
                  src={src}
                  alt={alt || ''}
                />
              </button>
              {caption && (
                <figcaption class="mt-2 text-sm text-muted">
                  {href ? (
                    <a href={href} class="inline-flex items-center gap-1 hover:text-primary hover:underline">
                      {caption}
                      <Icon name="tabler:arrow-up-right" class="h-3.5 w-3.5" />
                    </a>
                  ) : (
                    caption
                  )}
                </figcaption>
              )}
            </figure>
          </li>
        ))
      }
    </ul>

    {
      lightbox && (
        <dialog
          class="m-auto max-h-[92vh] max-w-[92vw] rounded-lg bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm open:flex open:flex-col"
          aria-label="Visualizzatore foto"
        >
          <form method="dialog" class="absolute right-2 top-2 z-10">
            <button
              type="submit"
              class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80"
              aria-label="Chiudi"
            >
              <Icon name="tabler:x" class="h-5 w-5" />
            </button>
          </form>
          <button
            type="button"
            class="absolute left-2 top-1/2 z-10 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80"
            data-aw-gallery-prev
            aria-label="Foto precedente"
          >
            <Icon name="tabler:chevron-left" class="h-5 w-5" />
          </button>
          <button
            type="button"
            class="absolute right-2 top-1/2 z-10 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80"
            data-aw-gallery-next
            aria-label="Foto successiva"
          >
            <Icon name="tabler:chevron-right" class="h-5 w-5" />
          </button>
          <img data-aw-gallery-img class="max-h-[82vh] w-auto rounded-lg object-contain select-none touch-pan-y" alt="" draggable="false" />
          <p class="mt-2 text-center text-sm text-white/90">
            <span data-aw-gallery-counter class="font-semibold tabular-nums"></span>
            <span data-aw-gallery-caption></span>
          </p>
        </dialog>
      )
    }
  </aw-gallery>
</WidgetWrapper>

<script>
  class AwGallery extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector<HTMLDialogElement>('dialog');
      if (!dialog) return;
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-aw-gallery-open]')];
      const img = dialog.querySelector<HTMLImageElement>('[data-aw-gallery-img]')!;
      const caption = dialog.querySelector<HTMLElement>('[data-aw-gallery-caption]')!;
      const counter = dialog.querySelector<HTMLElement>('[data-aw-gallery-counter]')!;
      let current = 0;
      // Nel visualizzatore si usa l'immagine originale (data-full), non la miniatura.
      const fullSrc = (i: number) => {
        const b = buttons[(i + buttons.length) % buttons.length];
        const thumb = b.querySelector('img');
        return b.dataset.full || thumb?.currentSrc || thumb?.src || '';
      };
      const show = (index: number) => {
        current = (index + buttons.length) % buttons.length;
        const source = buttons[current].querySelector('img');
        if (!source) return;
        img.src = fullSrc(current);
        img.alt = source.alt;
        counter.textContent = buttons.length > 1 ? `${current + 1} / ${buttons.length}` : '';
        const text = buttons[current].closest('figure')?.querySelector('figcaption')?.textContent?.trim();
        caption.textContent = text ? ` · ${text}` : '';
        // precarica la foto successiva e la precedente per uno scorrimento fluido
        [current + 1, current - 1].forEach((i) => { const pre = new Image(); pre.src = fullSrc(i); });
      };
      // Swipe orizzontale su telefono e tablet
      let startX = 0, startY = 0;
      dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }, { passive: true });
      dialog.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        const dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(dx < 0 ? current + 1 : current - 1);
      }, { passive: true });
      buttons.forEach((button, index) =>
        button.addEventListener('click', () => {
          show(index);
          dialog.showModal();
        })
      );
      dialog.querySelector('[data-aw-gallery-prev]')?.addEventListener('click', () => show(current - 1));
      dialog.querySelector('[data-aw-gallery-next]')?.addEventListener('click', () => show(current + 1));
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(current - 1);
        if (event.key === 'ArrowRight') show(current + 1);
      });
      // Click on the backdrop closes the viewer.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
  }
  if (!customElements.get('aw-gallery')) customElements.define('aw-gallery', AwGallery);
</script>
