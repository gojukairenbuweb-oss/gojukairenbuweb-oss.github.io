---
import { getCollection } from 'astro:content';
import { SEZIONI, CATEGORIE_GALLERIE } from '../content.config';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A.S.D. Renbukan – Karate Goju Kai, Roma' } = Astro.props;

const pagine = (await getCollection('pagine', (p) => p.data.menu)).sort(
  (a, b) => a.data.order - b.data.order,
);
// Menu a sezioni, come nel vecchio sito
const sezioni = SEZIONI.map((nome) => ({
  nome,
  pagine: pagine.filter((p) => p.data.sezione === nome),
})).filter((s) => s.pagine.length > 0);

const path = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- PoC: non indicizzare -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} | A.S.D. Renbukan Goju Kai Roma</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/media/pagine/chi-siamo/stemma.webp" alt="" width="44" height="46" />
        <span>A.S.D. Renbukan <small>Goju Kai Roma</small></span>
      </a>
      <nav aria-label="Menu principale">
        <ul class="menu">
          {sezioni.map((s) => (
            <li class="has-sub">
              <a href={`/${s.pagine[0].id}/`} aria-haspopup="true"
                 class={s.pagine.some((p) => path.startsWith(`/${p.id}`)) ? 'active' : ''}>{s.nome}</a>
              <ul class="sub">
                {s.pagine.map((p) => <li><a href={`/${p.id}/`}>{p.data.title}</a></li>)}
              </ul>
            </li>
          ))}
          <li><a href="/news/" class={path.startsWith('/news') ? 'active' : ''}>News</a></li>
          <li><a href="/eventi/" class={path.startsWith('/eventi') ? 'active' : ''}>Eventi</a></li>
          <li class="has-sub">
            <a href="/gallerie/" aria-haspopup="true" class={path.startsWith('/gallerie') ? 'active' : ''}>Foto Gallery</a>
            <ul class="sub">
              {CATEGORIE_GALLERIE.map((c) => <li><a href={`/gallerie/categoria/${c.slug}/`}>{c.nome}</a></li>)}
            </ul>
          </li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>A.S.D. Renbukan – Via Antonino Pio 78, Roma (zona San Paolo)</p>
      <p>© {year} · Sito di prova (PoC) – contenuti non definitivi</p>
    </footer>
  </body>
</html>
