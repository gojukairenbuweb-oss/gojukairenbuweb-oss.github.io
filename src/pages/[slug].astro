---
import { getCollection, render } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import PageShell from '~/components/site/PageShell.astro';
import Prose from '~/components/site/Prose.astro';
import Gallery from '~/components/widgets/Gallery.astro';

export async function getStaticPaths() {
  const pagine = await getCollection('pagine');
  return pagine.map((p) => ({
    params: { slug: p.id },
    props: {
      pagina: p,
      fratelli: pagine.filter((x) => x.data.sezione === p.data.sezione && x.data.menu).sort((a, b) => a.data.order - b.data.order),
    },
  }));
}
const { pagina, fratelli } = Astro.props;
const { Content } = await render(pagina);
const d = pagina.data;
---

<PageLayout metadata={{ title: d.title }}>
  <PageShell
    title={d.title}
    kicker={d.sezione}
    nav={fratelli.length > 1 ? { title: d.sezione, items: fratelli.map((f) => ({ text: f.data.title, href: `/${f.id}`, current: f.id === pagina.id })) } : undefined}
  >
    {d.cover && <img src={d.cover} alt={d.cover_alt ?? ""} class="rounded-xl mb-8 w-auto max-w-full max-h-[26rem] md:float-right md:ml-8 md:max-w-[45%] shadow-sm" />}
    <Prose><Content /></Prose>
    {
      d.allegati.length > 0 && (
        <ul class="mt-8 grid gap-3">
          {d.allegati.map((a) => (
            <li>
              <a href={a.file} target="_blank" rel="noopener" class="btn btn-secondary">📄 {a.titolo}</a>
            </li>
          ))}
        </ul>
      )
    }
  </PageShell>
  {
    d.galleria.length > 0 && (
      <Gallery
        title="Galleria"
        columns={3}
        images={d.galleria.map((g, i) => ({ src: g.immagine, alt: g.didascalia ?? `${d.title} – foto ${i + 1}`, caption: g.didascalia }))}
        classes={{ container: 'pt-0' }}
      />
    )
  }
</PageLayout>
