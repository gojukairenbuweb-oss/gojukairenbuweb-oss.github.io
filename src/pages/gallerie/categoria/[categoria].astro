---
import PageLayout from '~/layouts/PageLayout.astro';
import PageShell from '~/components/site/PageShell.astro';
import CardGrid from '~/components/site/CardGrid.astro';
import { CATEGORIE_GALLERIE } from '~/content.config';
import { categorieConGallerie, quando } from '~/lib/gallerie';
export async function getStaticPaths() {
  return (await categorieConGallerie()).map((c) => ({ params: { categoria: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const anni = [...new Set(cat.gallerie.map((g) => g.data.date?.getFullYear() ?? 'Senza data'))];
---
<PageLayout metadata={{ title: cat.nome }}>
  <PageShell title={cat.nome} kicker="Foto Gallery"
    nav={{ title: 'Categorie', items: CATEGORIE_GALLERIE.map((c) => ({ text: c.nome, href: `/gallerie/categoria/${c.slug}`, current: c.slug === cat.slug })) }}>
    {cat.gallerie.length === 0 && <p class="text-muted">Le gallerie di questa categoria saranno migrate a breve dal vecchio sito.</p>}
    {anni.map((anno) => (
      <section class="mb-10">
        {anni.length > 1 && <h2 class="font-heading text-2xl font-bold mb-4">{anno}</h2>}
        <CardGrid columns={2} cards={cat.gallerie.filter((g) => (g.data.date?.getFullYear() ?? 'Senza data') === anno)
          .map((g) => ({ href: `/gallerie/${g.id}`, title: g.data.title, image: g.data.foto[0]?.immagine, meta: `${quando(g)}${g.data.luogo ? ` · ${g.data.luogo}` : ''} · ${g.data.foto.length} foto` }))} />
      </section>
    ))}
  </PageShell>
</PageLayout>
