---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { gallerieOrdinate, quando, slugCategoria } from '../../lib/gallerie';

export async function getStaticPaths() {
  const gallerie = await gallerieOrdinate();
  return gallerie.map((g) => ({ params: { slug: g.id }, props: { item: g } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
---

<Base title={d.title}>
  <p class="meta">
    <a href="/gallerie/">Foto Gallery</a> › <a href={`/gallerie/categoria/${slugCategoria(d.categoria)}/`}>{d.categoria}</a>
  </p>
  <h1>{d.title}</h1>
  <p class="meta">{quando(item)}{d.luogo && ` · ${d.luogo}`} · {d.foto.length} foto</p>
  <div class="prose"><Content /></div>
  <div class="gallery">
    {d.foto.map((f, i) => (
      <figure>
        <a href={f.immagine}><img src={f.immagine} alt={f.didascalia ?? `${d.title} – foto ${i + 1}`} loading="lazy" /></a>
        {f.didascalia && <figcaption>{f.didascalia}</figcaption>}
      </figure>
    ))}
  </div>
</Base>
