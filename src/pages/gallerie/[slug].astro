---
import { render } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import PageShell from '~/components/site/PageShell.astro';
import Prose from '~/components/site/Prose.astro';
import Gallery from '~/components/widgets/Gallery.astro';
import { gallerieOrdinate, quando, slugCategoria } from '~/lib/gallerie';
export async function getStaticPaths() {
  return (await gallerieOrdinate()).map((g) => ({ params: { slug: g.id }, props: { item: g } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
---
<PageLayout metadata={{ title: d.title }}>
  <PageShell title={d.title} kicker={d.categoria}>
    <p class="text-muted -mt-3 mb-6">{quando(item)}{d.luogo && ` · ${d.luogo}`} · {d.foto.length} foto · <a class="text-primary" href={`/gallerie/categoria/${slugCategoria(d.categoria)}`}>altre gallerie della categoria</a></p>
    <Prose><Content /></Prose>
  </PageShell>
  <Gallery columns={4} images={d.foto.map((f, i) => ({ src: f.immagine, alt: f.didascalia ?? `${d.title} – foto ${i + 1}`, caption: f.didascalia }))} classes={{ container: 'pt-0' }} />
</PageLayout>
