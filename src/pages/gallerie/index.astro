---
import PageLayout from '~/layouts/PageLayout.astro';
import PageShell from '~/components/site/PageShell.astro';
import CardGrid from '~/components/site/CardGrid.astro';
import { categorieConGallerie } from '~/lib/gallerie';
const categorie = await categorieConGallerie();
---
<PageLayout metadata={{ title: 'Foto Gallery' }}>
  <PageShell title="Foto Gallery">
    <CardGrid cards={categorie.map((c) => ({
      href: `/gallerie/categoria/${c.slug}`,
      title: c.nome,
      image: c.gallerie[0]?.data.foto[0]?.immagine,
      meta: c.gallerie.length === 0 ? 'In arrivo' : `${c.gallerie.length} ${c.gallerie.length === 1 ? 'galleria' : 'gallerie'} · ${c.gallerie.reduce((n, g) => n + g.data.foto.length, 0)} foto`,
    }))} />
  </PageShell>
</PageLayout>
