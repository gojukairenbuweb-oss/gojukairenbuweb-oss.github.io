---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatRange, eventoFuturo, isPublished, byDateDesc } from '../../lib/format';

const oggi = new Date(new Date().toDateString());
const tutti = await getCollection('eventi', isPublished);
const futuri = tutti.filter((e) => eventoFuturo(e, oggi)).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const passati = tutti.filter((e) => !eventoFuturo(e, oggi)).sort(byDateDesc);
---

<Base title="Eventi">
  <h1>Eventi</h1>
  <h2>In programma</h2>
  {futuri.length === 0 ? <p class="meta">Nessun evento in programma.</p> : (
    <ul>{futuri.map((e) => <li><a href={`/eventi/${e.id}/`}>{e.data.title}</a> – {formatRange(e.data.date, e.data.data_fine)}{e.data.luogo && `, ${e.data.luogo}`} <span class="meta">({e.data.tipo})</span></li>)}</ul>
  )}
  <h2>Archivio</h2>
  <ul>{passati.map((e) => <li><a href={`/eventi/${e.id}/`}>{e.data.title}</a> – {formatRange(e.data.date, e.data.data_fine)}</li>)}</ul>
</Base>
