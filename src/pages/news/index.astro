---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import PageShell from '~/components/site/PageShell.astro';
import CardGrid from '~/components/site/CardGrid.astro';
import { formatDate, isPublished, byDateDesc } from '~/lib/format';
const news = (await getCollection('news', isPublished)).sort(byDateDesc);
---
<PageLayout metadata={{ title: 'News' }}>
  <PageShell title="News">
    <CardGrid cards={news.map((n) => ({ href: `/news/${n.id}`, title: n.data.title, image: n.data.cover, meta: formatDate(n.data.date) + (n.data.draft ? ' · BOZZA' : ''), text: n.data.summary }))} />
  </PageShell>
</PageLayout>
