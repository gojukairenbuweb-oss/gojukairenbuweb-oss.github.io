---
import { getCollection, render } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import PageShell from '~/components/site/PageShell.astro';
import Prose from '~/components/site/Prose.astro';
import { formatDate, isPublished } from '~/lib/format';
export async function getStaticPaths() {
  return (await getCollection('news', isPublished)).map((n) => ({ params: { slug: n.id }, props: { item: n } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
---
<PageLayout metadata={{ title: item.data.title, description: item.data.summary }}>
  <PageShell title={item.data.title} kicker={`News · ${formatDate(item.data.date)}`}>
    {item.data.cover && <img src={item.data.cover} alt="" class="rounded-xl mb-8 max-w-full md:max-w-xl shadow-sm" />}
    <Prose><Content /></Prose>
    <p class="mt-10"><a href="/news" class="text-primary font-semibold">← Tutte le news</a></p>
  </PageShell>
</PageLayout>
